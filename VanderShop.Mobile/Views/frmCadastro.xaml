<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VanderShop.Views.frmCadastro"
    Title="Criar conta"
    SafeAreaEdges="Container">

    <ScrollView>

        <Grid
            RowDefinitions="Auto,Auto"
            RowSpacing="20"
            Padding="0,0,0,24">

            <Grid
                Padding="24,16,24,28"
                BackgroundColor="{StaticResource ShopYellow}"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="10">

                <Label
                    Text="VanderShop"
                    FontSize="23"
                    FontFamily="OpenSansSemibold" />

                <Label
                    Grid.Row="1"
                    Text="Sua conta começa aqui"
                    Style="{StaticResource ShopTitle}" />

                <Label
                    Grid.Row="2"
                    Text="Preencha seus dados e prepare sua próxima compra." />

            </Grid>

            <Border
                Grid.Row="1"
                Margin="20,0"
                Style="{StaticResource ShopCard}">

                <Grid
                    x:Name="formulario"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="16">

                    <Grid
                        RowDefinitions="Auto,Auto"
                        RowSpacing="7">

                        <Label
                            Text="Nome completo"
                            Style="{StaticResource ShopFieldLabel}" />

                        <Border
                            Grid.Row="1"
                            Style="{StaticResource ShopInput}">

                            <Entry
                                x:Name="txtNome"
                                Placeholder="Como você se chama?"
                                MaxLength="100" />

                        </Border>

                    </Grid>

                    <Grid
                        Grid.Row="1"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="7">

                        <Label
                            Text="Documento"
                            Style="{StaticResource ShopFieldLabel}" />

                        <Border
                            Grid.Row="1"
                            Style="{StaticResource ShopInput}">

                            <Entry
                                x:Name="txtDocumento"
                                Placeholder="CPF ou outro documento"
                                MaxLength="20" />

                        </Border>

                    </Grid>

                    <Grid
                        Grid.Row="2"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="7">

                        <Label
                            Text="Telefone"
                            Style="{StaticResource ShopFieldLabel}" />

                        <Border
                            Grid.Row="1"
                            Style="{StaticResource ShopInput}">

                            <Entry
                                x:Name="txtTelefone"
                                Placeholder="Telefone com DDD"
                                Keyboard="Telephone"
                                MaxLength="20" />

                        </Border>

                    </Grid>

                    <Grid
                        Grid.Row="3"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="7">

                        <Label
                            Text="E-mail"
                            Style="{StaticResource ShopFieldLabel}" />

                        <Border
                            Grid.Row="1"
                            Style="{StaticResource ShopInput}">

                            <Entry
                                x:Name="txtEmail"
                                Placeholder="Seu melhor e-mail"
                                Keyboard="Email"
                                IsSpellCheckEnabled="False"
                                MaxLength="150" />

                        </Border>

                    </Grid>

                    <Grid
                        Grid.Row="4"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="7">

                        <Label
                            Text="Senha"
                            Style="{StaticResource ShopFieldLabel}" />

                        <Border
                            Grid.Row="1"
                            Style="{StaticResource ShopInput}">

                            <Entry
                                x:Name="txtSenha"
                                Placeholder="Crie uma senha"
                                IsPassword="True"
                                MaxLength="128" />

                        </Border>

                        <Label
                            Grid.Row="2"
                            Text="Use pelo menos 8 caracteres."
                            Style="{StaticResource ShopMuted}" />

                    </Grid>

                    <Grid
                        Grid.Row="5"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="7">

                        <Label
                            Text="Confirmar senha"
                            Style="{StaticResource ShopFieldLabel}" />

                        <Border
                            Grid.Row="1"
                            Style="{StaticResource ShopInput}">

                            <Entry
                                x:Name="txtConfirmacao"
                                Placeholder="Digite a senha novamente"
                                IsPassword="True"
                                MaxLength="128"
                                ReturnType="Go"
                                Completed="Cadastrar_Clicked" />

                        </Border>

                    </Grid>

                    <Button
                        x:Name="btnCadastrar"
                        Grid.Row="6"
                        Text="Criar minha conta"
                        Clicked="Cadastrar_Clicked" />

                    <Label
                        Grid.Row="7"
                        Text="Já tenho conta. Entrar"
                        Style="{StaticResource ShopLink}">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="VoltarLogin_Tapped" />
                        </Label.GestureRecognizers>

                    </Label>

                </Grid>

            </Border>

        </Grid>

    </ScrollView>

</ContentPage>